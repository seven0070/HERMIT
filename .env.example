# =====================================================================
# Universal API Gateway Keys (Layer 2)
# =====================================================================

# Primary: Gemini API Key (get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Universal Gateway: OpenRouter (1 API key connects to 200+ models with free/cheap tiers)
# Get from https://openrouter.ai/keys
UNIVERSAL_API_KEY=your_openrouter_api_key_here

# Fast Inference Fallbacks:
# Groq (Free high-speed Llama & Mixtral models): https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Nebius Token Factory: https://studio.nebius.ai/
NEBIUS_API_KEY=your_nebius_api_key_here

# =====================================================================
# Local Inference (Hermit Base Model — MiniCPM5-2B-FP8 via vLLM)
# =====================================================================

# Path to the quantized model (or any HF model name vLLM can serve)
LOCAL_MODEL=D:/RAD/model optimizer/quantized_models/MiniCPM5-2B-FP8

# vLLM server address (default port 8000)
LOCAL_VLLM_URL=http://localhost:8000/v1

# Pin to a specific provider instead of auto-routing:
#   local_minicpm | universal_openrouter | gemini | groq
# Leave unset for auto (local first, cloud fallback)
# PREFERRED_PROVIDER=local_minicpm
